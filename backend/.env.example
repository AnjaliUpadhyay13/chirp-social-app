# Server
NODE_ENV=development
PORT=5001

# MongoDB (local default; for Atlas use your mongodb+srv:// URI)
MONGODB_URI=mongodb://127.0.0.1:27017/social_app

# Frontend origin allowed by CORS (comma-separated for several)
CLIENT_ORIGIN=http://localhost:5173

# Auth (used from Phase 2) - generate a long random string, never commit the real one
JWT_SECRET=replace-with-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=sid

# App settings
POST_MAX_LENGTH=280
